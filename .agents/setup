#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."
SECONDS=0

echo 'Checking PHP 8.4 and Composer system packages...'
packages=(ca-certificates git unzip composer php8.4-cli php8.4-curl php8.4-mbstring php8.4-xml php8.4-zip php8.4-sqlite3)
missing=()
for package in "${packages[@]}"; do
    if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -qx 'install ok installed'; then
        missing+=("$package")
    fi
done

if ((${#missing[@]})); then
    sudo apt-get update
    sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${missing[@]}"
fi
echo "System packages ready (${SECONDS}s)."

# Match CI even if another PHP version is also installed in the base image.
if [[ "$(php -r 'echo PHP_MAJOR_VERSION.".".PHP_MINOR_VERSION;')" != '8.4' ]]; then
    sudo update-alternatives --set php /usr/bin/php8.4
fi
php --version
composer --version

echo 'Installing locked Composer dependencies (including development tools)...'
started=$SECONDS
composer install --no-interaction --no-progress --prefer-dist
composer check-platform-reqs
echo "Composer dependencies ready ($((SECONDS - started))s)."
echo "Orb setup finished (${SECONDS}s)."
