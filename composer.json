{
    "name": "laravel-gtm/hubspot-sdk",
    "description": "Laravel-ready PHP API SDK boilerplate built with Saloon (template repository).",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "saloonphp/saloon": "^4.5.2",
        "saloonphp/laravel-plugin": "^4.3 || ^5.0.1",
        "saloonphp/rate-limit-plugin": "^2.5.3"
    },
    "require-dev": {
        "larastan/larastan": "^3.14",
        "laravel/pint": "^1.32.1",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.3",
        "pestphp/pest": "^5.3.5",
        "phpstan/phpstan": "^2.3.5"
    },
    "autoload": {
        "psr-4": {
            "LaravelGtm\\HubspotSdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaravelGtm\\HubspotSdk\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "pest --coverage",
        "lint": "vendor/bin/pint --test",
        "format": "vendor/bin/pint",
        "analyse": "phpstan analyse"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelGtm\\HubspotSdk\\Laravel\\HubspotServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
